LINK MACRO "Main_capvsv" "780.004"
{
TABLE "Edit Macro Info" "780.004"
{
element 0 "MacroType" "PEL"
}
data
{
BLKEDIT "Macro Editor"
{
 !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
 !! macro MEASURE IC-CAP2009             default.mdl>model New>macro Main April 2010!!
 !! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·!!
 !! This is the Main MEASURE macro TEMPLATE to help organize the characterization   !!
 !! procedure to be defined first in a model (p.147 IC-CAP User's guide).           !!
 !!                                                                                 !!
 !! This "macro Main" consist of a single "SITE" (=combined DIE+SUB(/MOD)) loop     !!
 !! for automatic wafer measurements steered using the ProbePlan (file) and the     !!
 !! Prober macro from the Cascade prober 'model' (better: driver).                  !!
 !!                                                                                 !!
 !! USAGE: Place your real measurement model into this "New" model and give it a    !!
 !! more meaningful name and save it to a file with a preferably different name     !!
 !! and extension .mdl in the user's home directory its /mdl folder or otherwise.   !!
 !!                                                                                 !!
 !! IMPORTANT: The ProbePlan SUBSITES information must MATCH ALWAYS the Measurement !!
 !!   DUT-Setups EXACTLY .. if e.g. one of the measurements is skipped then...      !!
 !!   ... you have to update the ProbePlan and omit that SUBSITE that belongs to it !!
 !!                                                                                 !!
 !! Note: 1) SITE counts from 0 to ( DIES*SUBS - 1 ) ; SUB counts from 0 to SUBS-1  !!
 !!       2) the Matrix macro from the Cascade prober 'model' steers the HP5250     !!
 !!       switch matrix that is used ONLY in the Cascade32 10-pins probe set-up.    !!
 !! More: The SUB systemvariable is used to select the appropriate (sequence of)    !!
 !!       Measurement(s) (DUT/Setup/Measure..) for the current MODULE (you name it).!!
 !!       A measurement may be preceeded by calling (switch) Matrix where the       !!
 !!       switch matrix settings may be pre-set locally in the setup's variables .. !!
 !!       (DevCons) that may be filled in thru the ProbeCard part of the GUI by     !!
 !!       opening the ProbeCard editor clicking on a pin radio button, saving etc.  !!
 !!       Transform(s) may follow the measurement or use off-line postprocessing.   !!
 !!       The SET systemvariable (full path output-file) in ExportDataMeasured is   !!
 !!       automatically controlled and updated per measurement.                     !!
 !!       The output (ExportDataMeasured) files are automatically organized in the  !!
 !!       current user's home mdm folder in e.g. Ax1234_w1_YYYMMDD.hhmmss current   !!
 !!       measurement-run folder. The output is further divided over sequentially   !!
 !!       numbered die-folders containing sequential numbered mdm data files ..     !!
 !!       The mdm output files contain all information for off-line processing.     !!
 !! Hint: In case of 'groups' of SUBs that combine use e.g. a modulo 'grp' like:    !!
 !!         SUBgrp=SUB-val(val$((SUB-grp/2+0.5)/(grp),"%.0f"))*grp                  !!
 !!       ALTERNATIVE derive modulo op. from IC-CAP functions 'ceil' and/or 'floor' !!
 !! Hint: more example(s) can be found in \opt\cad\iccap_2009\USE\mdl e.g. PDMs.mdl !!
 !!       PDMs.mdl uses setup Instrument Options (HP4156) > Init Command :DISP OFF  !!
 !!       is saving a lot of time for HP4156A in particular                         !!
 !! Note: if 'PRINTER IS afilename' is used close with 'PRINTER IS CRT' asap avoids !!
 !!       undesired intercepting in-between status print(s) from /Cascade/.. macros !!
 !! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·!!
 !! Main                 created: 230508 (pjfs): default.mdl >model New >macro Main !!
 !! ====                 revised:        (    ):                                    !!
 !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
 
 LINPUT "ICPnr_Wafernr? (no spaces)",WAFER,MDM                                ! Wfr_ID 
 LINPUT "COMMENT present measure-run?",MDM,COMMENT                            ! Run_ID 
 
 while SITE < DIES*SUBS                                                       !>SITE
 ! print "DIEx=";DIEx;" ";"DIEy=";DIEy;"SUB=";SUB                             ! sysvar
 ! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·
 ! if SUB == ... then                                                         !>>SUB
 !   MODULE="Module"                                                          ! MODULE
 !   iccap_func("macro /Cascade/Matrix","Execute","/New/DUT/Setup")           !/matrix
    iccap_func("setup /Diode_Rez_1/Cap_v_V/C_lin","Measure")                  !/MeaSET
 !   iccap_func("transform /New/DUT/Setup/Transform","Perform Transform")     !/(trfm)
    iccap_func("setup /Diode_Rez_1/Cap_v_V/C_lin","ExportDataMeasured",val$(SET))   !/#.mdm
 ! ...                                                                        ! etc
 ! endif                                                                      !<<SUB
 ! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·
   iccap_func("macro /Cascade/Prober","Execute","")                           ! ->next
 endwhile                                                                     !<SITE
 
 !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
}
}
}
