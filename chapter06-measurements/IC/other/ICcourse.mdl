LINK MACRO "Main_VDP_log_Meander_2" "780.004"
{
TABLE "Edit Macro Info" "780.004"
{
element 0 "MacroType" "PEL"
}
data
{
BLKEDIT "Macro Editor"
{
 iccap_func("setup /Diode_Schottky/Res_PN/vdPauw_M_B","Measure")
 !iccap_func("setup /Diode_Schottky/Res_PN/vdPauw_M_B","Extract")
 iccap_func("setup /Diode_Schottky/Res_PN/vdPauw_M_B","ExportDataMeasured",val$(SET))
 !
 !****************************************
 !
 ! berekening Rsheet
 !
 !****************************************
 !
 ! Henk v. Zeijl 05/02/03
 !
 !
 
 npoints = 51
 
 COMPLEX deltaV[npoints]
 COMPLEX Vfit[npoints]
 COMPLEX ValidData[npoints]
 
 COMPLEX vforce[npoints]
 COMPLEX v1[npoints]
 COMPLEX v2[npoints]
 COMPLEX Iforce[npoints]
 
 i =0
 WHILE i < npoints
 
  vforce[i] = /Diode_Schottky/Res_PN/vdPauw_M_B/vforce[i]
  v1[i] = /Diode_Schottky/Res_PN/vdPauw_M_B/v1[i]
  v2[i] = /Diode_Schottky/Res_PN/vdPauw_M_B/v2[i]
  Iforce[i] = /Diode_Schottky/Res_PN/vdPauw_M_B/Iforce[i]
 
  i = i + 1
 
 END WHILE
 
 i = 0
 num = 0
 X1 = 0
 Y1 = 0
 X2 = 0
 Y2 = 0
 SXY1 = 0
 SXX1 = 0
 SYY1 = 0
 SXY2 = 0
 SXX2 = 0
 Rsheet = 0
 correllation = 0
 Y_offset = 0
 DataPoints = 0
 hllng1 = 0
 correllation = 0
 snpnt1 = 0
 
 PRINTER IS CRT
 !
 !gemiddelden bepalen, num = aantal 
 !regressie punten 1-st and last measurements are skipped
 !
 ! discard DataSkip measurements at the beginning and end of the sweep
 !
 vcompliance = 20
 WHILE i < npoints
   ValidData[i] = -1
   IF vcompliance > 1.1 * abs(vforce[i]) THEN 
     num = num + 1
     ValidData[i] = 1
     deltaV[i] = (v1[i] - v2[i])
     X1 = X1 + Iforce[i] 
     Y1 = Y1 + deltaV[i]
   END IF 
   i = i + 1
 END WHILE
 print num,vcompliance
 
 IF num > 1 THEN
   X1 = X1 / num
   Y1 = Y1 / num
   i = 0
 !
 !kruis-termen berekenen
 !
 
   WHILE i < npoints
     IF ValidData[i] > 0 THEN
       SXY1 = SXY1 + ( Iforce[i] - X1 ) * ( deltaV[i] - Y1 )
       SXX1 = SXX1 + ( Iforce[i] - X1 ) * ( Iforce[i] - X1 )
       SYY1 = SYY1 + ( deltaV[i] - Y1 ) * ( deltaV[i] - Y1 )
     END IF
     i = i + 1
   END WHILE
 !
 !helling en snijpunt  berekenen
 !
   hllng1 = SXY1 / SXX1
   snpnt1 = Y1 - hllng1 * X1
 ! correllatie coefficient berekenen
   correllation = SXY1/(sqrt(SXX1*SYY1)+1E-50)
 END IF
 !
 printer is CRT
 print " Resistance =",hllng1
 print " corellatie coefficient =",correllation
 print " offset in Y     =",snpnt1
 print " number of data points: ", num
 !
 
 
 Rsheet = hllng1
 Y_offset = snpnt1
 DataPoints = num
 
 ! fit-lijn uitrekenen
 !
 i=0
 WHILE i < npoints
   Vfit[i] = Iforce[i] * hllng1 + snpnt1
   i = i + 1
 END WHILE
 
 
 
 PRINTER IS CRT
 !
 !initialisatie variabelen
 !
 COMPLEX deltaV[npoints]
 !
 i=0
 WHILE i < npoints 
   deltaV[i] = (v1[i] - v2[i])
   i = i + 1
 END WHILE
 PRINT  "--------------------"
 filename = val$("Meander_RES_VdPAUW_2") &val$(SITE) &val$(".xls")
 
 PRINTER IS filename
 PRINT "I  force = ";"0";" till ";"50ma"
 PRINT "Operator: "; system$("logname")
 PRINT "_____________________________________________________________________"
 PRINT " "
 PRINT "(v1[i] - v2[i])	           Iforce"
 PRINT "_____________________________________________________________________"
 i = 0   
 WHILE i < npoints
   PRINT deltaV[i],Iforce[i]
   i = i + 1
 END WHILE
 
 print " Resistance =",hllng1
 print " corellatie coefficient =",correllation
 print " offset in Y     =",snpnt1
 print " number of data points: ", num
 
}
}
}
LINK MACRO "Main_SN_RES" "780.004"
{
TABLE "Edit Macro Info" "780.004"
{
element 0 "MacroType" "PEL"
}
data
{
BLKEDIT "Macro Editor"
{
 !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
 !! macro MEASURE IC-CAP2009             default.mdl>model New>macro Main April 2010!!
 !! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·!!
 !! This is the Main MEASURE macro TEMPLATE to help organize the characterization   !!
 !! procedure to be defined first in a model (p.147 IC-CAP User's guide).           !!
 !!                                                                                 !!
 !! This "macro Main" consist of a single "SITE" (=combined DIE+SUB(/MOD)) loop     !!
 !! for automatic wafer measurements steered using the ProbePlan (file) and the     !!
 !! Prober macro from the Cascade prober 'model' (better: driver).                  !!
 !!                                                                                 !!
 !! USAGE: Place your real measurement model into this "New" model and give it a    !!
 !! more meaningful name and save it to a file with a preferably different name     !!
 !! and extension .mdl in the user's home directory its /mdl folder or otherwise.   !!
 !!                                                                                 !!
 !! IMPORTANT: The ProbePlan SUBSITES information must MATCH ALWAYS the Measurement !!
 !!   DUT-Setups EXACTLY .. if e.g. one of the measurements is skipped then...      !!
 !!   ... you have to update the ProbePlan and omit that SUBSITE that belongs to it !!
 !!                                                                                 !!
 !! Note: 1) SITE counts from 0 to ( DIES*SUBS - 1 ) ; SUB counts from 0 to SUBS-1  !!
 !!       2) the Matrix macro from the Cascade prober 'model' steers the HP5250     !!
 !!       switch matrix that is used ONLY in the Cascade32 10-pins probe set-up.    !!
 !! More: The SUB systemvariable is used to select the appropriate (sequence of)    !!
 !!       Measurement(s) (DUT/Setup/Measure..) for the current MODULE (you name it).!!
 !!       A measurement may be preceeded by calling (switch) Matrix where the       !!
 !!       switch matrix settings may be pre-set locally in the setup's variables .. !!
 !!       (DevCons) that may be filled in thru the ProbeCard part of the GUI by     !!
 !!       opening the ProbeCard editor clicking on a pin radio button, saving etc.  !!
 !!       Transform(s) may follow the measurement or use off-line postprocessing.   !!
 !!       The SET systemvariable (full path output-file) in ExportDataMeasured is   !!
 !!       automatically controlled and updated per measurement.                     !!
 !!       The output (ExportDataMeasured) files are automatically organized in the  !!
 !!       current user's home mdm folder in e.g. Ax1234_w1_YYYMMDD.hhmmss current   !!
 !!       measurement-run folder. The output is further divided over sequentially   !!
 !!       numbered die-folders containing sequential numbered mdm data files ..     !!
 !!       The mdm output files contain all information for off-line processing.     !!
 !! Hint: In case of 'groups' of SUBs that combine use e.g. a modulo 'grp' like:    !!
 !!         SUBgrp=SUB-val(val$((SUB-grp/2+0.5)/(grp),"%.0f"))*grp                  !!
 !!       ALTERNATIVE derive modulo op. from IC-CAP functions 'ceil' and/or 'floor' !!
 !! Hint: more example(s) can be found in \opt\cad\iccap_2009\USE\mdl e.g. PDMs.mdl !!
 !!       PDMs.mdl uses setup Instrument Options (HP4156) > Init Command :DISP OFF  !!
 !!       is saving a lot of time for HP4156A in particular                         !!
 !! Note: if 'PRINTER IS afilename' is used close with 'PRINTER IS CRT' asap avoids !!
 !!       undesired intercepting in-between status print(s) from /Cascade/.. macros !!
 !! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·!!
 !! Main                 created: 230508 (pjfs): default.mdl >model New >macro Main !!
 !! ====                 revised:        (    ):                                    !!
 !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
 
 LINPUT "ICPnr_Wafernr? (no spaces)",WAFER,MDM                                ! Wfr_ID 
 LINPUT "COMMENT Wafer type measure-run?",MDM,WAFER_TYPE                      ! Run_ID 
 
 while SITE < DIES*SUBS                                                       !>SITE
 ! print "DIEx=";DIEx;" ";"DIEy=";DIEy;"SUB=";SUB                             ! sysvar
 ! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·
 ! if SUB == ... then                                                         !>>SUB
 !   MODULE="Module"                                                          ! MODULE
 !   iccap_func("macro /Cascade/Matrix","Execute","/New/DUT/Setup")           !/matrix
 !   iccap_func("setup /New/DUT/Setup","Measure")                             !/MeaSET
 !   iccap_func("transform /New/DUT/Setup/Transform","Perform Transform")     !/(trfm)
 !   iccap_func("setup /New/DUT/Setup","ExportDataMeasured",val$(SET))        !/#.mdm
 
 !iccap_func("macro /Diode_Rez_1/Diode","Execute")
 
 if SUB == 0 then                                                         !>>SUB
    MODULE="SN_W5_206"                                                          ! MODULE
 
 iccap_func("macro /Diode_Schottky/Main_SN_RES_1","Execute")
 iccap_func("/Diode_Schottky/Res_PN/SN_RES_1/R","Create Image","SN_RES_L206_W5_"&val$(DIE)&".png",800,800,96)
 !iccap_func("/Diode_Schottky/Res_PN/SN_RES_1/R","Create Image","SN_RES_L50_W2_"&val$(DIE)&".png",800,800,96)
  endif   
 
 if SUB == 1 then                                                         !>>SUB
    MODULE="SN_W10_206"                                                        ! MODULE
 
 iccap_func("macro /Diode_Schottky/Main_SN_RES_2","Execute")
 iccap_func("/Diode_Schottky/Res_PN/SN_RES_2/R","Create Image","SN_RES_L206_W10_"&val$(DIE)&".png",800,800,96)
 !iccap_func("/Diode_Schottky/Res_PN/SN_RES_2/R","Create Image","SN_RES_L500_W2_"&val$(DIE)&".png",800,800,96)
 endif                                                                      !<<SUB
 
 !iccap_func("setup /SMACK/DC/Photodiode","ExportDataMeasured",val$(SET))         !/#.mdm
 !iccap_func("setup /Diode_Rez_1/vdP_1/Rsq2","ExportDataMeasured",val$(SET))
 !iccap_func("setup /Diode_Rez_1/vdP_1/Rsq3","ExportDataMeasured",val$(SET))
 !iccap_func("setup /Diode_Rez_1/vdP_1/Rsq4","ExportDataMeasured",val$(SET))
 
 ! ...                                                                        ! etc
 ! endif                                                                      !<<SUB
 ! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·
   iccap_func("macro /Cascade/Prober","Execute","")                           ! ->next
 endwhile                                                                     !<SITE
 
 !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
}
}
}
LINK MACRO "Main_SN_RES_1" "780.004"
{
TABLE "Edit Macro Info" "780.004"
{
element 0 "MacroType" "PEL"
}
data
{
BLKEDIT "Macro Editor"
{
 iccap_func("setup /Diode_Schottky/Res_PN/SN_RES_1","Measure")
 !iccap_func("setup /Diode_Schottky/Res_PN/vdPauw","Extract")
 iccap_func("setup /Diode_Schottky/Res_PN/SN_RES_1","ExportDataMeasured",val$(SET))
 !
 !****************************************
 !
 ! berekening Rsheet
 !
 !****************************************
 !
 ! Henk v. Zeijl 05/02/03
 !
 !
 
 npoints = 51
 
 COMPLEX deltaV[npoints]
 COMPLEX Vfit[npoints]
 COMPLEX ValidData[npoints]
 
 COMPLEX vforce[npoints]
 COMPLEX v1[npoints]
 COMPLEX v2[npoints]
 COMPLEX Iforce[npoints]
 
 i =0
 WHILE i < npoints
 
  vforce[i] = /Diode_Schottky/Res_PN/SN_RES_1/vforce[i]
  v1[i] = /Diode_Schottky/Res_PN/SN_RES_1/v1[i]
  v2[i] = /Diode_Schottky/Res_PN/SN_RES_1/v2[i]
  Iforce[i] = /Diode_Schottky/Res_PN/SN_RES_1/Iforce[i]
 
  i = i + 1
 
 END WHILE
 
 i = 0
 num = 0
 X1 = 0
 Y1 = 0
 X2 = 0
 Y2 = 0
 SXY1 = 0
 SXX1 = 0
 SYY1 = 0
 SXY2 = 0
 SXX2 = 0
 Rsheet = 0
 correllation = 0
 Y_offset = 0
 DataPoints = 0
 hllng1 = 0
 correllation = 0
 snpnt1 = 0
 
 PRINTER IS CRT
 !
 !gemiddelden bepalen, num = aantal 
 !regressie punten 1-st and last measurements are skipped
 !
 ! discard DataSkip measurements at the beginning and end of the sweep
 !
 vcompliance = 20
 WHILE i < npoints
   ValidData[i] = -1
   IF vcompliance > 1.1 * abs(vforce[i]) THEN 
     num = num + 1
     ValidData[i] = 1
     deltaV[i] = (v1[i] - v2[i])
     X1 = X1 + Iforce[i] 
     Y1 = Y1 + deltaV[i]
   END IF 
   i = i + 1
 END WHILE
 print num,vcompliance
 
 IF num > 1 THEN
   X1 = X1 / num
   Y1 = Y1 / num
   i = 0
 !
 !kruis-termen berekenen
 !
 
   WHILE i < npoints
     IF ValidData[i] > 0 THEN
       SXY1 = SXY1 + ( Iforce[i] - X1 ) * ( deltaV[i] - Y1 )
       SXX1 = SXX1 + ( Iforce[i] - X1 ) * ( Iforce[i] - X1 )
       SYY1 = SYY1 + ( deltaV[i] - Y1 ) * ( deltaV[i] - Y1 )
     END IF
     i = i + 1
   END WHILE
 !
 !helling en snijpunt  berekenen
 !
   hllng1 = SXY1 / SXX1
   snpnt1 = Y1 - hllng1 * X1
 ! correllatie coefficient berekenen
   correllation = SXY1/(sqrt(SXX1*SYY1)+1E-50)
 END IF
 !
 printer is CRT
 print " resistance =",hllng1
 print " corellatie coefficient =",correllation
 print " offset in Y     =",snpnt1
 print " number of data points: ", num
 !
 
 
 Rsheet = hllng1
 Y_offset = snpnt1
 DataPoints = num
 
 ! fit-lijn uitrekenen
 !
 i=0
 WHILE i < npoints
   Vfit[i] = Iforce[i] * hllng1 + snpnt1
   i = i + 1
 END WHILE
 
 
 
 PRINTER IS CRT
 !
 !initialisatie variabelen
 !
 COMPLEX deltaV[npoints]
 !
 i=0
 WHILE i < npoints 
   deltaV[i] = (v1[i] - v2[i])
   i = i + 1
 END WHILE
 PRINT  "--------------------"
 filename = val$("SN_RES_L206_W5") &val$(SITE) &val$(".xls")
 !filename = val$("SN_RES_L50_W2") &val$(SITE) &val$(".xls")
 
 PRINTER IS filename
 PRINT "I  force = ";"0";" till ";"6ma"
 PRINT "Operator: "; system$("logname")
 PRINT "_____________________________________________________________________"
 PRINT " "
 PRINT "(v1[i] - v2[i])	           Iforce"
 PRINT "_____________________________________________________________________"
 i = 0   
 WHILE i < npoints
   PRINT deltaV[i],Iforce[i]
   i = i + 1
 END WHILE
 
 print " Resistance =",hllng1
 print " corellatie coefficient =",correllation
 print " offset in Y     =",snpnt1
 print " number of data points: ", num
 
}
}
}
LINK MACRO "Main_SN_RES_2" "780.004"
