 print"average Rsq=";avrg[0];" Ohm/sqr"
 print"average Rsq=";avrg[0]*1000;" mOhm/sqr"
 print""
 PRINTER IS CRT
 
 
 
 
 
 
 
 
 
 
 
 !   iccap_func("setup /Diode_Rez_1/vdP_1_Bend_test/Rsq/Rsq","Measure")                             !/MeaSET
 !   iccap_func("transform /Diode_Rez_1/vdP_1_Bend_test/Rsq/Rsq","Perform Transform")           !/(trfm)
 
 !   iccap_func("setup /Diode_Rez_1/vdP_1_Bend_test/Rsq/Rsq","ExportDataMeasured",val$(SET))         !/#.mdm
 
}
}
