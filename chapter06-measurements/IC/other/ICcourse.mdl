LINK MACRO "Diode_data_loop" "780.004"
{
TABLE "Edit Macro Info" "780.004"
{
element 0 "MacroType" "PEL"
}
data
{
BLKEDIT "Macro Editor"
{
 dir$ = val$(HOME) 
 !LINPUT "The directory to store the files in is: ",dir$,dir$
 
 !dataname1$ = val$(HOME)&"\bend_test\2_Sept_temp_measurements_sample4_Full_box\bend_test_4_5\bend_test_4_5.txt"
 !dataname2$ = val$(HOME)&"\bend_test\2_Sept_temp_measurements_sample4_Full_box\bend_test_0\bend_test_0.txt"
 md_mdir$ 	 = val$(HOME)&"\diode\4_oct\Diode_4_NW_SUB_70_70_no_SN_CNT\No_light\mdm"
 
 plot_dir1$ = val$(HOME)&"\diode\4_oct\Diode_4_NW_SUB_70_70_no_SN_CNT\No_light\mdm\1"
 plot_dir2$ = val$(HOME)&"\diode\4_oct\Diode_4_NW_SUB_70_70_no_SN_CNT\No_light\mdm\2"
 plot_dir3$ = val$(HOME)&"\diode\4_oct\Diode_4_NW_SUB_70_70_no_SN_CNT\No_light\mdm\3"
 
 !index = 1
 
 !PRINTER IS dataname1$
 !print "Slno	slope(R)		corr-coeff		Rsq "
 
 !PRINTER IS dataname2$ 
 !print "Slno	slope(R)		corr-coeff 		Rsq "
 
  
 ii=0
 while ii < 2
   iccap_func("macro /Diode_Rez_1/Diode_data","Execute")
   ii = ii+1
 
 iccap_func("ic-cap","Change Directory",md_mdir$)
 !iccap_func("/Diode_Rez_1/Diode/setup_C3_A1/Diode_I_V_Anode","Create Image","Diode_I_V_Anode.png",600,600,96)
 !iccap_func("/Diode_Rez_1/Diode/setup_C3_A1/Diode_I_Cathode","Create Image","Diode_I_Cathode.png",600,600,96)
 !iccap_func("/Diode_Rez_1/Diode/setup_C3_A1/Diode_I_V_Substrate","Create Image","Diode_I_V_Substrate.png",600,600,96)
 iccap_func("setup /Diode_Rez_1/Diode/setup_C3_A1","ExportDataMeasured",val(ii))          !/#.mdm
 
 !Plotting graphs! 
 IF ii == 1 THEN
   iccap_func("ic-cap","Change Directory",plot_dir1$)
   iccap_func("/Diode_Rez_1/Diode/setup_C3_A1/Diode_I_V_Anode","Create Image","Diode_I_V_Anode.png",800,800,96)
   iccap_func("/Diode_Rez_1/Diode/setup_C3_A1/Diode_I_Cathode","Create Image","Diode_I_Cathode.png",800,800,96)
   iccap_func("/Diode_Rez_1/Diode/setup_C3_A1/Diode_I_V_Substrate","Create Image","Diode_I_V_Substrate.png",800,800,96)
 END IF
 
 IF ii == 2 THEN
   iccap_func("ic-cap","Change Directory",plot_dir2$)
   iccap_func("/Diode_Rez_1/Diode/setup_C3_A1/Diode_I_V_Anode","Create Image","Diode_I_V_Anode.png",800,800,96)
   iccap_func("/Diode_Rez_1/Diode/setup_C3_A1/Diode_I_Cathode","Create Image","Diode_I_Cathode.png",800,800,96)
   iccap_func("/Diode_Rez_1/Diode/setup_C3_A1/Diode_I_V_Substrate","Create Image","Diode_I_V_Substrate.png",800,800,96)
 END IF
 
 IF ii == 3 THEN
   iccap_func("ic-cap","Change Directory",plot_dir3$)
   iccap_func("/Diode_Rez_1/Diode/setup_C3_A1/Diode_I_V_Anode","Create Image","Diode_I_V_Anode.png",800,800,96)
   iccap_func("/Diode_Rez_1/Diode/setup_C3_A1/Diode_I_Cathode","Create Image","Diode_I_Cathode.png",800,800,96)
