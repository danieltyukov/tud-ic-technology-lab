LINK MACRO "Freq_Cap_plot" "780.004"
{
TABLE "Edit Macro Info" "780.004"
{
element 0 "MacroType" "PEL"
}
data
{
BLKEDIT "Macro Editor"
{
 !CM=""
 !while CM <> "4294" and CM <>"4284"
 !  LINPUT "Which CM are you using (4284 or 4294) [4284]?","4284",CM  
 !endwhile
 !Mode=""
 !while Mode <> "Cp" and Mode <>"Cs"
 !  LINPUT "Do you want parallel or series (Cp or Cs) [Cp]?","Cp",Mode
 !endwhile
 
 LINPUT "Filename to save measured results?","test",filename    
 !InitCommand = "FUNC:IMP CPRP"
 
 !InitCommand = ":MEAS CPR"
 !if Mode=="Cs" then InitCommand = ":MEAS CSR"
 
 !if CM == "4284" then
 !  InitCommand = "FUNC:IMP CPRP"
 !  if Mode=="Cs" then InitCommand = "FUNC:IMP CSRS"
 !endif
 
 !iccap_func("/Diode_Rez_1/Cap_v_f/C/C","SetInstrumentOptionValue", "Init Command", InitCommand) 
 
 Amp=0.05                              ! oscillation level LCR meter 
 Cap/C/Amplitude=Amp                   ! instrument option LCR meter
 i=0
 Fi=20                                 ! initial point (say ..min 40 Hz for 4294)
 iccap_func("/Diode_Rez_1/Cap_v_f/C/C","SetInstrumentOptionValue", "Delay for Timeouts", 10) 
 ! print "Amp Freq C G"
 while i <= 70                   ! up to / incl.  (say ..max 1MHz for 4284) 
   Cap_v_f/C/Frequency=Fi                  ! instrument option LCR meter
 
 !iccap_func("/Diode_Rez_1/Cap_v_f/C/C","SetInstrumentOptionValue", "Init Command", InitCommand) 
 menu_func("Cap_v_f/C","Measure")
 !-+
 ! if i<1 then LINPUT "next point ", dummy
 !LINPUT "next point ", dummy
 
 
   Ci = Cap_v_f/C/C[0]                     ! measurement result C
   Gi = Cap_v_f/C/G[0]                     ! measurement result 1/R
   Freq = "ICCAP_ARRAY["&val$(i+1)&"]" ! 'REDIM' Freq (Plot X Data)
   Cval = "ICCAP_ARRAY["&val$(i+1)&"]" ! 'REDIM' Model Variable ICCAP_ARRAY
   Gval = "ICCAP_ARRAY["&val$(i+1)&"]" ! 'REDIM' Model Variable ICCAP_ARRAY
   Cap_v_f/Plot/N=i+1                      ! 'REDIM' Freq and Cval Input "dataset"
  iccap_func(".","SetVariableTableValue","Freq["&val$(i)&"]",val$(Fi))
