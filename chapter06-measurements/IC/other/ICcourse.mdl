LINK CIRC "Circuit" "780.004"
{
data
{
circuitdeck
{
 Q1 1 = C 2 = B 3 = E 4 = S NPN AREA = 1.0
 .MODEL NPN NPN
 + IS = 1E-16
 + BF = 100
 + NF = 1
 + VAF = 1000
 + IKF = 10
 + ISE = 0
 + NE = 1.5
 + BR = 1
 + NR = 1
 + VAR = 1000
 + IKR = 10
 + ISC = 0
 + NC = 2
 + RB = 0
 + IRB = 10
 + RBM = 0
 + RE = 0
 + RC = 0
 + XTB = 0
 + EG = 1.110
 + XTI = 3.000
 + CJE = 0
 + VJE = 750m
 + MJE = 333m
 + TF  = 0
 + XTF = 0
 + VTF = 1000
 + ITF = 0
 + PTF = 0
 + CJC = 0
 + VJC = 750m
 + MJC = 333m
 + XCJC = 1.0
 + TR  = 1n
 + CJS = 0
 + VJS = 750m
 + MJS = 0
 + FC  = 500.0m
}
}
}
