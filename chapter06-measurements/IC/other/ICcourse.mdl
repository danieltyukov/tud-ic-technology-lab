 if i == 30 then Fi = 2500
 if i == 31 then Fi = 3000
 if i == 32 then Fi = 3750
 if i == 33 then Fi = 4000
 if i == 34 then Fi = 5000
 if i == 35 then Fi = 6000
 if i == 36 then Fi = 7500
 if i == 37 then Fi = 8000
 if i == 38 then Fi = 10000
 if i == 39 then Fi = 12000
 if i == 40 then Fi = 15000
