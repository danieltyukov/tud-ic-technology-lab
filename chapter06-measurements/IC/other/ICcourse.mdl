LINK MACRO "test_1" "780.004"
{
TABLE "Edit Macro Info" "780.004"
{
element 0 "MacroType" "PEL"
}
data
{
BLKEDIT "Macro Editor"
{
 LINPUT "ICPnr_Wafernr? (no spaces)",WAFER,MDM                                ! Wfr_ID 
 LINPUT "COMMENT Wafer type measure-run?",MDM,WAFER_TYPE                      ! Run_ID
 
 PRINTER IS CRT
 print WAFER_TYPE
 print WAFER
 Temp="25"
 DIEx=1
 DIEy=1
 V_start=-2
 V_end=2
 
 
 
 print " "
 print " "
 print " "
 print " "
 print "WAFER               : ";WAFER
 print "DIE COORDINATES     : X = ";DIEx;" Y = ";DIEy
 print "WAFER_TYPE          : ";WAFER_TYPE
 PRINT Temp,"gr. C"
 print "Date: "; system$("date ")
 print "Operator: "; system$("logname")
 
 diepos=val$(DIEx)&val$(DIEy)
 filename = val$(WAFER_TYPE) &val$("die") &val$(diepos) &val$(".vdp")
 PRINTER IS CRT
 print "filename =";filename
 
 !LINPUT"Are the values displayed in hpterm correct?",y_or_no
 
 !!
 !array's initialiseren
 !
 COMPLEX V_anode [251]
 COMPLEX V_anode_sense [251]
 COMPLEX V_cathode [251]
 COMPLEX V_cathode_sense [251]
 COMPLEX I_anode [251]
 COMPLEX I_cathode [251]
 COMPLEX V_input [251]
 COMPLEX I_substrate [251]
 npnts = 251
 numm = npnts
 !i = 0
 !WHILE i < numm
 
   !V_anode[i] = /Diode_Schottky/Diode/setup_C3_A1/V_Anode[i]
  ! V_anode_sense[i] = /Diode_Schottky/Diode/setup_C3_A1/V_Anode_Sense[i]
  ! V_input[i]  = abs(V_anode[i] - V_anode_sense[i])!
  ! I_cathode[i] = /Diode_Schottky/Diode/setup_C3_A1/I_Cathode[i]
  ! I_anode[i] = /Diode_Schottky/Diode/setup_C3_A1/I_Anode[i]
  ! I_substrate[i] = /Diode_Schottky/Diode/setup_C3_A1/I_Substrate[i]
 
  ! i = i + 1
 
 !END WHILE
 !PRINTER IS "summary.dat"
 !PRINT "V_input           Ianode          Icathode		Isubstrate  "
 !i = 0
 !WHILE i < numm
 !  PRINT V_input[i];"	";I_anode[i];"	";I_cathode[i];"	";I_substrate[i]
 !  i = i + 20
 !END WHILE
 
 PRINTER IS filename
 print "WAFER               : ";WAFER
 print "WAFER_TYPE          : ";WAFER_TYPE
 print "DIE COORDINATES     : X = ";DIEx;" Y = ";DIEy
 print "Forward biased Schottky diode 2 probes/bondpad on Anode and Cathode"
 print "Vstart = "; V_start ;" till " ; "Vend = ";V_end 
 print " Number of points" ;npnts ;" points"
 PRINT Temp,"gr. C"
 print "Date: "; system$("date ")
 print "Operator: "; system$("logname")
 print "V_INPUT = V_ANODE-V_ANODE_SENSE"  
 
 
 PRINTER IS filename
 PRINT "__________________________________________________________________"
 PRINT " "
 PRINT "V_INPUT	I_ANODE	I_CATHODE	I_SUBSTRATE"
 PRINT " "
 PRINT "__________________________________________________________________"
 
 i = 0   
 WHILE i < numm
 !PRINT V_input[i];"	";I_anode[i];"	";I_cathode[i];"	";I_substrate[i]
 PRINT V_start;"	";V_end;"	";npnts;"	";V_start
  i = i + 1
 END WHILE
 
 RETURN
}
}
}
LINK MACRO "Main_diode_test" "780.004"
{
TABLE "Edit Macro Info" "780.004"
{
element 0 "MacroType" "PEL"
}
data
{
BLKEDIT "Macro Editor"
{
 
 LINPUT "ICPnr_Wafernr? (no spaces)",WAFER,MDM                                ! Wfr_ID 
 LINPUT "COMMENT Wafer type measure-run?",MDM,WAFER_TYPE                      ! Run_ID 
 
 while SITE < DIES*SUBS                                                       !>SITE
 ! print "DIEx=";DIEx;" ";"DIEy=";DIEy;"SUB=";SUB                             ! sysvar
 ! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·
 ! if SUB == ... then                                                         !>>SUB
 !   MODULE="Module"                                                          ! MODULE
 !   iccap_func("macro /Cascade/Matrix","Execute","/New/DUT/Setup")           !/matrix
 !   iccap_func("setup /New/DUT/Setup","Measure")                             !/MeaSET
 !   iccap_func("transform /New/DUT/Setup/Transform","Perform Transform")     !/(trfm)
 !   iccap_func("setup /New/DUT/Setup","ExportDataMeasured",val$(SET))        !/#.mdm
 
 extract_dir1$ = val$(HOME)&"\Sch_M\11_7\Wafer_184_NW_9E12_VT_full_250_20"
 iccap_func("ic-cap","Change Directory",extract_dir1$)
 
 
 iccap_func("setup /Diode_Schottky/Diode/setup_C3_A1","Measure")
 iccap_func("setup /Diode_Schottky/Diode/setup_C3_A1","ExportDataMeasured",val$(SET))
 !iccap_func("macro /Diode_Schottky/Plot_macro","Execute")
 
 
 PRINTER IS CRT
 print WAFER_TYPE
 print WAFER
 print DIEx
 print DIEy
 print SITE
 Temp="21"
 
 
 V_start=-2
 V_end=2
 
 print " "
 print " "
 print " "
 print " "
 print "WAFER               : ";MDM
 print "DIE COORDINATES     : X = ";DIEx;" Y = ";DIEy
 print "WAFER_TYPE          : ";WAFER_TYPE
 PRINT Temp,"gr. C"
 print "Date: "; system$("date ")
 print "Operator: "; system$("logname")
 
 diepos=val$(DIEx) &val$("_") &val$(DIEy)
 filename = val$(WAFER_TYPE) &val$("_die_") &val$(SITE) &val$("_")&val$(diepos) &val$(".xls")
 PRINTER IS CRT
 print "filename =";filename
 
 !!
 !array's initialiseren
 !
 
 COMPLEX V_anode [251]
 COMPLEX V_anode_sense [251]
 COMPLEX V_cathode [251]
 COMPLEX V_cathode_sense [251]
 COMPLEX I_anode [251]
 COMPLEX I_cathode [251]
 COMPLEX V_input [251]
 COMPLEX I_substrate [251]
 npnts = 251
 numm = npnts
 i = 0
 
 WHILE i < numm
 
  V_anode[i] = /Diode_Schottky/Diode/setup_C3_A1/V_Anode[i]
  V_anode_sense[i] = /Diode_Schottky/Diode/setup_C3_A1/V_Anode_Sense[i]
  V_cathode_sense[i] = /Diode_Schottky/Diode/setup_C3_A1/V_Cathode_Sense[i]
  V_input[i]  = V_anode_sense[i] - V_cathode_sense[i]
  I_cathode[i] = /Diode_Schottky/Diode/setup_C3_A1/I_Cathode[i]
  I_anode[i] = /Diode_Schottky/Diode/setup_C3_A1/I_Anode[i]
  I_substrate[i] = /Diode_Schottky/Diode/setup_C3_A1/I_Substrate[i]
 
  i = i + 1
 
 END WHILE
 
 
 
 PRINTER IS filename
 print "WAFER               : ";MDM
 print "WAFER_TYPE          : ";WAFER_TYPE
 print "DIE COORDINATES     : X = ";DIEx;" Y = ";DIEy
 print "DIE NUMBER          : ";SITE
 print "Forward biased Schottky diode 2 probes/bondpad on Anode and Cathode"
 print "Vstart = "; V_start ;" till " ; "Vend = ";V_end 
 print " Number of points" ;npnts ;" points"
 PRINT "Temp - ";Temp;"gr. C"
 print "Date: "; system$("date ")
 print "Operator: "; system$("logname")
 print "V_INPUT = V_ANODE_SENSE-V_CATHODE_SENSE"  
 
 
 PRINTER IS filename
 PRINT "__________________________________________________________________"
 PRINT " "
 PRINT "V_ANODE	V_INPUT	I_ANODE	I_CATHODE	I_SUBSTRATE"
 PRINT " "
 PRINT "__________________________________________________________________"
 
 i = 0   
 WHILE i < numm
 PRINT V_anode[i];"	";V_input[i];"	";I_anode[i];"	";I_cathode[i];"	";I_substrate[i]
 !PRINT V_start;"	";V_end;"	";npnts;"	";V_start
  i = i + 1
 END WHILE
 
 
 
 
 
 ! ...                                                                        ! etc
 ! endif                                                                      !<<SUB
 ! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·
   iccap_func("macro /Cascade/Prober","Execute","")                           ! ->next
 endwhile                                                                     !<SITE
 
 !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
 home$ = val$(HOME)
 
 iccap_func("ic-cap","Change Directory",home$)
}
}
}
LINK MACRO "Main_diode_fvbv" "780.004"
{
TABLE "Edit Macro Info" "780.004"
{
element 0 "MacroType" "PEL"
}
data
{
BLKEDIT "Macro Editor"
{
 home$ = val$(HOME)
 
 iccap_func("ic-cap","Change Directory",home$)
 
 LINPUT "ICPnr_Wafernr? (no spaces)",WAFER,MDM                                ! Wfr_ID 
 LINPUT "COMMENT Wafer type measure-run?",MDM,WAFER_TYPE                      ! Run_ID 
 
 while SITE < DIES*SUBS                                                       !>SITE
 ! print "DIEx=";DIEx;" ";"DIEy=";DIEy;"SUB=";SUB                             ! sysvar
 ! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·
 ! if SUB == ... then                                                         !>>SUB
 !   MODULE="Module"                                                          ! MODULE
 !   iccap_func("macro /Cascade/Matrix","Execute","/New/DUT/Setup")           !/matrix
 !   iccap_func("setup /New/DUT/Setup","Measure")                             !/MeaSET
 !   iccap_func("transform /New/DUT/Setup/Transform","Perform Transform")     !/(trfm)
 !   iccap_func("setup /New/DUT/Setup","ExportDataMeasured",val$(SET))        !/#.mdm
 
 extract_dir1$ = val$(HOME)&"\Sch_M\31_7\Wafer_147_NW_3E12_20_2"
 iccap_func("ic-cap","Change Directory",extract_dir1$)
 
 
 iccap_func("setup /Diode_Schottky/Diode_HC/setup_C6_A4","Measure")
 iccap_func("setup /Diode_Schottky/Diode_HC/setup_C6_A4","ExportDataMeasured",val$(SET))
 
 
 PRINTER IS CRT
 print WAFER_TYPE
 print WAFER
 print DIEx
 print DIEy
 print SITE
 Temp="21"
 
 
 V_start=-2
 V_end=2
 
 V_bvstart=-25
 V_bvend=0.1
 
 print " "
 print " "
 print " "
 print " "
 print "WAFER               : ";MDM
 print "DIE COORDINATES     : X = ";DIEx;" Y = ";DIEy
 print "WAFER_TYPE          : ";WAFER_TYPE
 PRINT Temp,"gr. C"
 print "Date: "; system$("date ")
 print "Operator: "; system$("logname")
 
 diepos=val$(DIEx) &val$("_") &val$(DIEy)
 filename = val$(WAFER_TYPE) &val$("_die_") &val$(SITE) &val$("_")&val$(diepos) &val$(".xls")
 filenamebv = val$(WAFER_TYPE) &val$("_die_") &val$(SITE) &val$("_BV_")&val$(diepos) &val$(".xls")
 PRINTER IS CRT
 print "filename =";filename
 print "filename =";filenamebv
 
 !!
 !array's initialiseren
 !
 
 COMPLEX V_anode [252]
 COMPLEX V_anode_sense [252]
 COMPLEX V_cathode [252]
 COMPLEX V_cathode_sense [252]
 COMPLEX I_anode [252]
 COMPLEX I_cathode [252]
 COMPLEX V_input [252]
 COMPLEX I_substrate [252]
 
 
 npnts = 251
 nptsbv = 206
 numm = npnts
 numbv = nptsbv
 i = 0
 
 WHILE i < numm
 
  !V_anode[i] = /Diode_Schottky/Diode/setup_C3_A1/V_Anode[i]
  !V_anode_sense[i] = /Diode_Schottky/Diode/setup_C3_A1/V_Anode_Sense[i]
  !V_cathode_sense[i] = /Diode_Schottky/Diode/setup_C3_A1/V_Cathode_Sense[i]
  !V_cathode_sense[i] = /Diode_Schottky/Diode/setup_C3_A1/V_Cathode[i]
  !V_input[i]  = V_anode_sense[i] - V_cathode_sense[i]
  !I_cathode[i] = /Diode_Schottky/Diode/setup_C3_A1/I_Anode[i]
  !I_anode[i] = /Diode_Schottky/Diode/setup_C3_A1/I_Anode[i]
  !I_substrate[i] = /Diode_Schottky/Diode/setup_C3_A1/I_Substrate[i]
 
  V_anode[i] = /Diode_Schottky/Diode_HC/setup_C6_A4/V_Anode[i]
  V_anode_sense[i] = /Diode_Schottky/Diode_HC/setup_C6_A4/V_Anode_Sense[i]
  V_cathode_sense[i] = /Diode_Schottky/Diode_HC/setup_C6_A4/V_Cathode[i]
  V_input[i]  = V_anode_sense[i] - V_cathode_sense[i]
  I_cathode[i] = /Diode_Schottky/Diode_HC/setup_C6_A4/I_Anode[i]
  I_anode[i] = /Diode_Schottky/Diode_HC/setup_C6_A4/I_Anode[i]
  !I_substrate[i] = /Diode_Schottky/Diode_HC/setup_C6_A4/I_Substrate[i]
 
  i = i + 1
 
 END WHILE
 
 
 
 PRINTER IS filename
 print "WAFER               : ";MDM
 print "WAFER_TYPE          : ";WAFER_TYPE
 print "DIE COORDINATES     : X = ";DIEx;" Y = ";DIEy
 print "DIE NUMBER          : ";SITE
 print "Forward biased Schottky diode 2 probes/bondpad on Anode and Cathode"
 print "Vstart = "; V_start ;" till " ; "Vend = ";V_end 
 print " Number of points" ;npnts ;" points"
 PRINT "Temp - ";Temp;"gr. C"
 print "Date: "; system$("date ")
 print "Operator: "; system$("logname")
 print "V_INPUT = V_ANODE_SENSE-V_CATHODE_SENSE"  
 
 
 PRINTER IS filename
 PRINT "__________________________________________________________________"
 PRINT " "
 PRINT "V_ANODE	V_INPUT	I_ANODE	I_CATHODE	I_SUBSTRATE"
 PRINT " "
 PRINT "__________________________________________________________________"
 
 i = 0   
 WHILE i < numm
 !PRINT V_anode[i];"	";V_input[i];"	";I_anode[i];"	";I_cathode[i];"	";I_substrate[i]
 
 PRINT V_anode[i];"	";V_input[i];"	";I_anode[i];"	";I_cathode[i];
 
 
 i = i + 1
 END WHILE
 
 ! For BREAKDOWN measurement !
 iccap_func("setup /Diode_Schottky/Diode_HC/setup_C6_A4_BV","Measure")
 iccap_func("setup /Diode_Schottky/Diode_HC/setup_C6_A4_BV","ExportDataMeasured",val$(SET))
 
 COMPLEX V_anode_bv [252]
 COMPLEX V_anode_sense_bv [252]
 COMPLEX V_cathode_bv [252]
 COMPLEX V_cathode_sense_bv [252]
 COMPLEX I_anode_bv [252]
 COMPLEX I_cathode_bv [252]
 COMPLEX V_input_bv [252]
 COMPLEX I_substrate_bv [252]
 
 npnts = 251
 nptsbv = 206
 numm = npnts
 numbv = nptsbv
 
 i = 0
 WHILE i < numbv
 
 
  !V_anode_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/V_Anode_BV[i]
  !V_anode_sense_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/V_Anode_Sense_BV[i]
  !V_cathode_sense_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/V_Cathode_Sense_BV[i]
  !V_input_bv[i]  = V_anode_sense_bv[i] - V_cathode_sense_bv[i]
  !I_cathode_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/I_Anode_BV[i]
  !I_anode_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/I_Anode_BV[i]
  !I_substrate_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/I_Substrate_BV[i]
 
  V_anode_bv[i] = /Diode_Schottky/Diode_HC/setup_C6_A4_BV/V_Anode_BV[i]
  V_anode_sense_bv[i] = /Diode_Schottky/Diode_HC/setup_C6_A4_BV/V_Anode_Sense_BV[i]
  V_cathode_sense_bv[i] = /Diode_Schottky/Diode_HC/setup_C6_A4_BV/V_Cathode_BV[i]
  V_input_bv[i]  = V_anode_sense_bv[i] - V_cathode_sense_bv[i]
  I_cathode_bv[i] = /Diode_Schottky/Diode_HC/setup_C6_A4_BV/I_Anode_BV[i]
  I_anode_bv[i] = /Diode_Schottky/Diode_HC/setup_C6_A4_BV/I_Anode_BV[i]
 
  i = i + 1
 
 END WHILE
 
 
 PRINTER IS filenamebv
 print "WAFER               : ";MDM
 print "WAFER_TYPE          : ";WAFER_TYPE
 print "DIE COORDINATES     : X = ";DIEx;" Y = ";DIEy
 print "DIE NUMBER          : ";SITE
 print "Reverse biased Schottky diode 2 probes/bondpad on Anode and Cathode"
 print "Vstart = "; V_bvstart ;" till " ; "Vend = ";V_bvend 
 print " Number of points" ;npnts ;" points"
 PRINT "Temp - ";Temp;"gr. C"
 print "Date: "; system$("date ")
 print "Operator: "; system$("logname")
 print "V_INPUT = V_ANODE_SENSE-V_CATHODE_SENSE"  
 
 
 PRINTER IS filenamebv
 PRINT "__________________________________________________________________"
 PRINT " "
 PRINT "V_ANODE	V_INPUT	I_ANODE	I_CATHODE	"
 PRINT " "
 PRINT "__________________________________________________________________"
 
 i = 0   
 WHILE i < numbv
 !PRINT V_anode_bv[i];"	";V_input_bv[i];"	";I_anode_bv[i];"	";I_cathode_bv[i];"	";I_substrate_bv[i]
 PRINT V_anode_bv[i];"	";V_input_bv[i];"	";I_anode_bv[i];"	";I_cathode_bv[i];
 i = i + 1
 END WHILE
 
 ! ...                                                                        ! etc
 ! endif                                                                      !<<SUB
 ! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·
   iccap_func("macro /Cascade/Prober","Execute","")                           ! ->next
 endwhile                                                                     !<SITE
 
 !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
 home$ = val$(HOME)
 
 iccap_func("ic-cap","Change Directory",home$)
}
}
}
LINK MACRO "Main_diode_fvbv_new" "780.004"
{
TABLE "Edit Macro Info" "780.004"
{
element 0 "MacroType" "PEL"
}
data
{
BLKEDIT "Macro Editor"
{
 home$ = val$(HOME)
 
 iccap_func("ic-cap","Change Directory",home$)
 
 LINPUT "ICPnr_Wafernr? (no spaces)",WAFER,MDM                                ! Wfr_ID 
 LINPUT "COMMENT Wafer type measure-run?",MDM,WAFER_TYPE                      ! Run_ID 
 
 while SITE < DIES*SUBS                                                       !>SITE
 ! print "DIEx=";DIEx;" ";"DIEy=";DIEy;"SUB=";SUB                             ! sysvar
 ! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·
 ! if SUB == ... then                                                         !>>SUB
 !   MODULE="Module"                                                          ! MODULE
 !   iccap_func("macro /Cascade/Matrix","Execute","/New/DUT/Setup")           !/matrix
 !   iccap_func("setup /New/DUT/Setup","Measure")                             !/MeaSET
 !   iccap_func("transform /New/DUT/Setup/Transform","Perform Transform")     !/(trfm)
 !   iccap_func("setup /New/DUT/Setup","ExportDataMeasured",val$(SET))        !/#.mdm
 
 extract_dir1$ = val$(HOME)&"\Sch_M\31_7\Wafer_185_NW_9E12_20_5_70fngr_150dg"
 iccap_func("ic-cap","Change Directory",extract_dir1$)
 
 iccap_func("setup /Diode_Schottky/Diode/setup_C3_A1","Measure")
 iccap_func("setup /Diode_Schottky/Diode/setup_C3_A1","ExportDataMeasured",val$(SET))
 
 
 PRINTER IS CRT
 print WAFER_TYPE
 print WAFER
 print DIEx
 print DIEy
 print SITE
 Temp="21"
 
 
 V_start=-2
 V_end=2
 
 V_bvstart=-40
 V_bvend=0.2
 
 print " "
 print " "
 print " "
 print " "
 print "WAFER               : ";MDM
 print "DIE COORDINATES     : X = ";DIEx;" Y = ";DIEy
 print "WAFER_TYPE          : ";WAFER_TYPE
 PRINT Temp,"gr. C"
 print "Date: "; system$("date ")
 print "Operator: "; system$("logname")
 
 diepos=val$(DIEx) &val$("_") &val$(DIEy)
 filename = val$(WAFER_TYPE) &val$("_die_") &val$(SITE) &val$("_")&val$(diepos) &val$(".xls")
 filenamebv = val$(WAFER_TYPE) &val$("_die_") &val$(SITE) &val$("_BV_")&val$(diepos) &val$(".xls")
 PRINTER IS CRT
 print "filename =";filename
 print "filename =";filenamebv
 
 !!
 !array's initialiseren
 !
 
 COMPLEX V_anode [252]
 COMPLEX V_anode_sense [252]
 COMPLEX V_cathode [252]
 COMPLEX V_cathode_sense [252]
 COMPLEX I_anode [252]
 COMPLEX I_cathode [252]
 COMPLEX V_input [252]
 COMPLEX I_substrate [252]
 
 
 npnts = 251
 nptsbv = 152
 numm = npnts
 numbv = nptsbv
 i = 0
 
 WHILE i < numm
 
  V_anode[i] = /Diode_Schottky/Diode/setup_C3_A1/V_Anode[i]
  V_anode_sense[i] = /Diode_Schottky/Diode/setup_C3_A1/V_Anode_Sense[i]
  V_cathode_sense[i] = /Diode_Schottky/Diode/setup_C3_A1/V_Cathode_Sense[i]
  V_input[i]  = V_anode_sense[i] - V_cathode_sense[i]
  I_cathode[i] = /Diode_Schottky/Diode/setup_C3_A1/I_Anode[i]
  I_anode[i] = /Diode_Schottky/Diode/setup_C3_A1/I_Anode[i]
  I_substrate[i] = /Diode_Schottky/Diode/setup_C3_A1/I_Substrate[i]
 
  i = i + 1
 
 END WHILE
 
 PRINTER IS filename
 print "WAFER               : ";MDM
 print "WAFER_TYPE          : ";WAFER_TYPE
 print "DIE COORDINATES     : X = ";DIEx;" Y = ";DIEy
 print "DIE NUMBER          : ";SITE
 print "Forward biased Schottky diode 2 probes/bondpad on Anode and Cathode"
 print "Vstart = "; V_start ;" till " ; "Vend = ";V_end 
 print " Number of points" ;npnts ;" points"
 PRINT "Temp - ";Temp;"gr. C"
 print "Date: "; system$("date ")
 print "Operator: "; system$("logname")
 print "V_INPUT = V_ANODE_SENSE-V_CATHODE_SENSE"  
 
 
 PRINTER IS filename
 PRINT "__________________________________________________________________"
 PRINT " "
 PRINT "V_ANODE	V_INPUT	I_ANODE	I_CATHODE	I_SUBSTRATE"
 PRINT " "
 PRINT "__________________________________________________________________"
 
 i = 0   
 WHILE i < numm
 
 PRINT V_anode[i];"	";V_input[i];"	";I_anode[i];"	";I_cathode[i];"	";I_substrate[i]
 
 
 
 i = i + 1
 END WHILE
 
 ! For BREAKDOWN measurement !
 iccap_func("setup /Diode_Schottky/Diode/setup_C4_BV","Measure")
 iccap_func("setup /Diode_Schottky/Diode/setup_C4_BV","ExportDataMeasured",val$(SET))
 
 COMPLEX V_anode_bv [252]
 COMPLEX V_anode_sense_bv [252]
 COMPLEX V_cathode_bv [252]
 COMPLEX V_cathode_sense_bv [252]
 COMPLEX I_anode_bv [252]
 COMPLEX I_cathode_bv [252]
 COMPLEX V_input_bv [252]
 COMPLEX I_substrate_bv [252]
 
 npnts = 251
 nptsbv = 202
 numm = npnts
 numbv = nptsbv
 
 i = 0
 WHILE i < numbv
 
  V_anode_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/V_Anode_BV[i]
  V_anode_sense_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/V_Anode_Sense_BV[i]
  V_cathode_sense_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/V_Cathode_Sense_BV[i]
  V_input_bv[i]  = V_anode_sense_bv[i] - V_cathode_sense_bv[i]
  I_cathode_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/I_Anode_BV[i]
  I_anode_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/I_Anode_BV[i]
  I_substrate_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/I_Substrate_BV[i]
 
  i = i + 1
 
 END WHILE
 
 
 PRINTER IS filenamebv
 print "WAFER               : ";MDM
 print "WAFER_TYPE          : ";WAFER_TYPE
 print "DIE COORDINATES     : X = ";DIEx;" Y = ";DIEy
 print "DIE NUMBER          : ";SITE
 print "Reverse biased Schottky diode 2 probes/bondpad on Anode and Cathode"
 print "Vstart = "; V_bvstart ;" till " ; "Vend = ";V_bvend 
 print " Number of points" ;npnts ;" points"
 PRINT "Temp - ";Temp;"gr. C"
 print "Date: "; system$("date ")
 print "Operator: "; system$("logname")
 print "V_INPUT = V_ANODE_SENSE-V_CATHODE_SENSE"  
 
 
 PRINTER IS filenamebv
 PRINT "__________________________________________________________________"
 PRINT " "
 PRINT "V_ANODE	V_INPUT	I_ANODE	I_CATHODE	I_Substrate"
 PRINT " "
 PRINT "__________________________________________________________________"
 
 i = 0   
 WHILE i < numbv
 PRINT V_anode_bv[i];"	";V_input_bv[i];"	";I_anode_bv[i];"	";I_cathode_bv[i];"	";I_substrate_bv[i]
 
 i = i + 1
 END WHILE
 
 ! ...                                                                        ! etc
 ! endif                                                                      !<<SUB
 ! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·
   iccap_func("macro /Cascade/Prober","Execute","")                           ! ->next
 endwhile                                                                     !<SITE
 
 !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
 home$ = val$(HOME)
 
 iccap_func("ic-cap","Change Directory",home$)
}
}
}
LINK MACRO "Main_Diode_BV" "780.004"
{
TABLE "Edit Macro Info" "780.004"
{
element 0 "MacroType" "PEL"
}
data
{
BLKEDIT "Macro Editor"
{
 home$ = val$(HOME)
 
 iccap_func("ic-cap","Change Directory",home$)
 
 LINPUT "ICPnr_Wafernr? (no spaces)",WAFER,MDM                                ! Wfr_ID 
 LINPUT "COMMENT Wafer type measure-run?",MDM,WAFER_TYPE                      ! Run_ID 
 
 while SITE < DIES*SUBS                                                       !>SITE
 ! print "DIEx=";DIEx;" ";"DIEy=";DIEy;"SUB=";SUB                             ! sysvar
 ! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·
 ! if SUB == ... then                                                         !>>SUB
 !   MODULE="Module"                                                          ! MODULE
 !   iccap_func("macro /Cascade/Matrix","Execute","/New/DUT/Setup")           !/matrix
 !   iccap_func("setup /New/DUT/Setup","Measure")                             !/MeaSET
 !   iccap_func("transform /New/DUT/Setup/Transform","Perform Transform")     !/(trfm)
 !   iccap_func("setup /New/DUT/Setup","ExportDataMeasured",val$(SET))        !/#.mdm
 
 extract_dir1$ = val$(HOME)&"\Sch_M\31_7\Wafer_149_NW_6E12_20_2_25fngr_BV"
 iccap_func("ic-cap","Change Directory",extract_dir1$)
 
 
 PRINTER IS CRT
 print WAFER_TYPE
 print WAFER
 print DIEx
 print DIEy
 print SITE
 Temp="21"
 
 
 V_start=-2
 V_end=2
 
 V_bvstart=-30
 V_bvend=0.2
 
 print " "
 print " "
 print " "
 print " "
 print "WAFER               : ";MDM
 print "DIE COORDINATES     : X = ";DIEx;" Y = ";DIEy
 print "WAFER_TYPE          : ";WAFER_TYPE
 PRINT Temp,"gr. C"
 print "Date: "; system$("date ")
 print "Operator: "; system$("logname")
 
 diepos=val$(DIEx) &val$("_") &val$(DIEy)
 filename = val$(WAFER_TYPE) &val$("_die_") &val$(SITE) &val$("_")&val$(diepos) &val$(".xls")
 filenamebv = val$(WAFER_TYPE) &val$("_die_") &val$(SITE) &val$("_BV_")&val$(diepos) &val$(".xls")
 PRINTER IS CRT
 print "filename =";filename
 print "filename =";filenamebv
 
 
 ! For BREAKDOWN measurement !
 iccap_func("setup /Diode_Schottky/Diode/setup_C4_BV","Measure")
 iccap_func("setup /Diode_Schottky/Diode/setup_C4_BV","ExportDataMeasured",val$(SET))
 
 COMPLEX V_anode_bv [252]
 COMPLEX V_anode_sense_bv [252]
 COMPLEX V_cathode_bv [252]
 COMPLEX V_cathode_sense_bv [252]
 COMPLEX I_anode_bv [252]
 COMPLEX I_cathode_bv [252]
 COMPLEX V_input_bv [252]
 COMPLEX I_substrate_bv [252]
 
 npnts = 251
 nptsbv = 202
 numm = npnts
 numbv = nptsbv
 
 i = 0
 WHILE i < numbv
 
  V_anode_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/V_Anode_BV[i]
  V_anode_sense_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/V_Anode_Sense_BV[i]
  V_cathode_sense_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/V_Cathode_Sense_BV[i]
  V_input_bv[i]  = V_anode_sense_bv[i] - V_cathode_sense_bv[i]
  I_cathode_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/I_Anode_BV[i]
  I_anode_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/I_Anode_BV[i]
  I_substrate_bv[i] = /Diode_Schottky/Diode/setup_C4_BV/I_Substrate_BV[i]
 
  i = i + 1
 
 END WHILE
 
 
 PRINTER IS filenamebv
 print "WAFER               : ";MDM
 print "WAFER_TYPE          : ";WAFER_TYPE
 print "DIE COORDINATES     : X = ";DIEx;" Y = ";DIEy
 print "DIE NUMBER          : ";SITE
 print "Reverse biased Schottky diode 2 probes/bondpad on Anode and Cathode"
 print "Vstart = "; V_bvstart ;" till " ; "Vend = ";V_bvend 
 print " Number of points" ;npnts ;" points"
 PRINT "Temp - ";Temp;"gr. C"
 print "Date: "; system$("date ")
 print "Operator: "; system$("logname")
 print "V_INPUT = V_ANODE_SENSE-V_CATHODE_SENSE"  
 
 
 PRINTER IS filenamebv
 PRINT "__________________________________________________________________"
 PRINT " "
 PRINT "V_ANODE	V_INPUT	I_ANODE	I_CATHODE	I_Substrate"
 PRINT " "
 PRINT "__________________________________________________________________"
 
 i = 0   
 WHILE i < numbv
 PRINT V_anode_bv[i];"	";V_input_bv[i];"	";I_anode_bv[i];"	";I_cathode_bv[i];"	";I_substrate_bv[i]
 
 i = i + 1
 END WHILE
 
 ! ...                                                                        ! etc
 ! endif                                                                      !<<SUB
 ! Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·Â·
   iccap_func("macro /Cascade/Prober","Execute","")                           ! ->next
 endwhile                                                                     !<SITE
 
